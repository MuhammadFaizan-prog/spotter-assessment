# No secrets are required: every upstream API is public and keyless.
# All variables are optional overrides.

# Django
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Only needed when the SPA runs on a different origin than the API (local dev uses the Vite proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Upstream APIs (defaults shown)
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
PHOTON_BASE_URL=https://photon.komoot.io
HTTP_USER_AGENT=spotter-weather-routing/1.0 (+https://github.com/MuhammadFaizan-prog/spotter-assessment)

# Frontend (Vite) — leave empty to call the same origin
VITE_API_BASE=
VITE_API_PROXY=http://127.0.0.1:8000
